# Gemini natural-language responses for customer chat (optional)
# Create a key in Google AI Studio and keep it only in your local .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
USE_GEMINI_FOR_COMMERCE=true

# Anthropic Claude API Key (Optional when USE_MOCKS=true)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Mock toggle: set to true to use MockInventoryService and MockContentService without external dependencies
USE_MOCKS=true

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./sellerpilot.db

# API Settings
API_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Confidence threshold below which commerce queries escalate to human
ESCALATION_CONFIDENCE_THRESHOLD=0.7
